[Unit]
Description=Abgeschlossenen Tesla-Wochenbericht per E-Mail versenden
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/home/do1ffe/tesla-audits/2026-10-30/bericht.json
ConditionPathExists=/home/do1ffe/tesla-audits/2026-10-30/bericht.txt
ConditionPathExists=!/home/do1ffe/tesla-audits/2026-10-30/mail-versand.json
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=do1ffe
Group=do1ffe
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/tesla-dashboard/telemetrie_wochenbericht_mailen.py --berichtordner /home/do1ffe/tesla-audits/2026-10-30
TimeoutStartSec=2min
Restart=on-failure
RestartSec=5min
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/do1ffe/tesla-audits/2026-10-30
PrivateTmp=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

