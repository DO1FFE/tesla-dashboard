[Unit]
Description=Tesla-Befunde isoliert prüfen und getestete Patches vorbereiten
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=do1ffe
Group=do1ffe
SupplementaryGroups=systemd-journal
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/tesla-dashboard/telemetrie_korrekturpruefung.py --projekt /home/do1ffe/tesla-dashboard --ausgabe /home/do1ffe/tesla-audits/2026-10-23-48h --ende 2026-10-25T13:50:00Z
TimeoutStartSec=4h
MemoryMax=2G
Nice=10
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/do1ffe/tesla-audits/2026-10-23-48h /home/do1ffe/.codex
ReadOnlyPaths=/home/do1ffe/tesla-dashboard
InaccessiblePaths=-/home/do1ffe/tesla-dashboard/.env -/home/do1ffe/tesla-dashboard/data/tesla_fleet -/home/do1ffe/.ssh
PrivateTmp=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

