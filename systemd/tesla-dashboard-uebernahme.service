[Unit]
Description=Geprüfte Dashboard-Korrekturen geschützt übernehmen
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=do1ffe
Group=do1ffe
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/tesla-dashboard/telemetrie_uebernahme.py --projekt /home/do1ffe/tesla-dashboard --ausgabe /home/do1ffe/tesla-audits/2026-10-23-48h --ende 2026-10-25T13:50:00Z
TimeoutStartSec=4h
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/do1ffe/tesla-dashboard /home/do1ffe/tesla-audits/2026-10-23-48h
PrivateTmp=true
MemoryMax=2G
Nice=10

[Install]
WantedBy=multi-user.target

