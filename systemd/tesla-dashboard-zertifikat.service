[Unit]
Description=Tesla-Telemetrie-Zertifikat erneuern und prüfen
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/tesla-dashboard/telemetrie_zertifikat_warten.py
TimeoutStartSec=8min
PrivateTmp=true

