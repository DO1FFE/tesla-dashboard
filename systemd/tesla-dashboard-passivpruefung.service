[Unit]
Description=Befristete passive Tesla-Logprüfung für 48 Stunden
After=tesla-dashboard.service
ConditionPathExists=!/home/do1ffe/tesla-audits/2026-10-23-48h/abschluss.json
OnSuccess=tesla-dashboard-passivmail.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
User=do1ffe
Group=do1ffe
SupplementaryGroups=systemd-journal
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/tesla-dashboard/telemetrie_passivpruefung.py --projekt /home/do1ffe/tesla-dashboard --ausgabe /home/do1ffe/tesla-audits/2026-10-23-48h --referenz /home/do1ffe/tesla-audits/2026-10-30/referenz.json --start 2026-10-23T13:50:00Z --ende 2026-10-25T13:50:00Z
Restart=on-failure
RestartSec=60s
Nice=10
MemoryMax=1G
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/do1ffe/tesla-audits/2026-10-23-48h
PrivateTmp=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

